# ============================================================================
# .htaccess — ONLY used on traditional Apache shared hosting (cPanel / Hostinger
# / Namecheap / Bluehost etc.). GitHub Pages and Cloudflare Pages ignore this
# file completely, so leaving it in place is harmless.
# ============================================================================

# --- 1. Force HTTPS ---------------------------------------------------------
# On GitHub Pages / Cloudflare Pages this is handled for you automatically.
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
# </IfModule>

# --- 2. Canonical www OR non-www (pick ONE, then uncomment it) ---------------
# The site is built for https://mahiuddin.com (no www). Uncomment one block:
#
# Force non-www:  www.mahiuddin.com -> mahiuddin.com
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
#   RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
# </IfModule>
#
# Force www:      mahiuddin.com -> www.mahiuddin.com  (only if you decide to
# use www; then also update every canonical URL, sitemap.xml and config.js)
# <IfModule mod_rewrite.c>
#   RewriteEngine On
#   RewriteCond %{HTTP_HOST} ^mahiuddin\.com$ [NC]
#   RewriteRule ^(.*)$ https://www.mahiuddin.com/$1 [R=301,L]
# </IfModule>

# --- 3. Clean 404 handling ----------------------------------------------------
ErrorDocument 404 /404.html

# --- 4. Trailing slashes on directories (keeps URLs matching the sitemap) -----
<IfModule mod_rewrite.c>
  RewriteEngine On
  # /about  ->  /about/   (only when the path really is a directory)
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# --- 5. Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>

# --- 6. Browser caching -------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# --- 7. Security headers ------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
